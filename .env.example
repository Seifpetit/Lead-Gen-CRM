# Copy to .env and fill in. Never commit .env.
APIFY_TOKEN=
# Optional: Google Places Text Search for discovery (server-side only).
GOOGLE_PLACES_API_KEY=
DATABASE_URL=postgres://leadgen:leadgen@localhost:5432/leadgen
PORT=3000
# Used by `npm test`. Tests drop and recreate the schema in this database.
TEST_DATABASE_URL=postgres://leadgen:leadgen@localhost:5432/leadgen_test
# Sign-up: invite (default; needs an invite code or an admin-created user) or open.
SIGNUP_MODE=invite
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
# Days a removed CRM card waits in Noise before the daily job deletes it.
NOISE_RETENTION_DAYS=30
# Starting paid runs through the API. Leave false until the pilot and your go-ahead.
PAID_RUNS_ENABLED=false
# Apify webhooks (optional; polling works without them): a long random secret and the server's public URL.
APIFY_WEBHOOK_SECRET=
PUBLIC_URL=
# LOCAL DEVELOPMENT ONLY. true accepts the login "test" / "test" (skips only the email-format and
# 12-character checks for that exact pair). The server refuses to start with it on if
# NODE_ENV=production, HOST is not loopback, or PUBLIC_URL is not a localhost URL.
# Switch off: set false, then run `npm run auth:disable-dev-user`.
DEV_ADMIN_LOGIN=false
# Optional: a Claude classifier for companies and job titles the rules cannot decide. Without a key,
# those go to manual review. Calls are billed by Anthropic and recorded in the cost ledger.
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-5-5
# Most the classifier may spend on one run (USD); past it, undecided items go to review.
CLASSIFIER_RUN_CAP_USD=0.5
# Interface the server binds to (loopback by default).
HOST=127.0.0.1
