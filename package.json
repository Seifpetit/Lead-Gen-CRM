{
  "name": "lead-gen-crm",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend",
    "db:rollback": "npm run db:rollback -w backend",
    "db:seed": "npm run db:seed -w backend",
    "build:shared": "tsc -b shared",
    "dev:backend": "npm run build:shared && npm run dev -w backend",
    "dev:frontend": "npm run build:shared && npm run dev -w frontend",
    "regions:set-bounds": "npm run regions:set-bounds -w backend --",
    "regions:build": "npm run regions:build -w backend --",
    "auth:create-user": "npm run auth:create-user -w backend --",
    "auth:disable-dev-user": "npm run auth:disable-dev-user -w backend",
    "auth:create-invite": "npm run auth:create-invite -w backend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
