{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "rootDir": "src",
    "outDir": "dist/types",
    "emitDeclarationOnly": true
  },
  "include": ["src", "src/**/*.json"],
  "references": [{ "path": "../shared" }]
}
